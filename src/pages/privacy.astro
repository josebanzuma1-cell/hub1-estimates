---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
const title = `Privacy Policy | ${SITE.name}`;
const description = 'What this site collects, what it does not, and how advertising cookies work.';
const canonical = '/privacy';
const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<BaseLayout {title} {description} {canonical}>
  <div class="page">
    <div class="tool-hero"><h1>Privacy policy</h1><p>Last updated {updated}.</p></div>
    <section class="prose">
      <h2>What we collect</h2>
      <p>
        Nothing you type into a calculator is sent to us. Every calculation on this
        site runs entirely in your browser. Figures are encoded into the page URL so
        that results can be shared, which means they exist in your address bar and in
        your browser history — but they are not transmitted to or stored on any
        server we control.
      </p>
      <p>
        Be aware that a URL containing your figures will be visible to anyone you
        send it to, and to anyone with access to your browser history. If your inputs
        are sensitive, clear them before sharing a link.
      </p>

      <h2>Analytics</h2>
      <p>
        We may use privacy-respecting analytics to count page views and referrers in
        aggregate. This does not identify individual visitors.
      </p>

      <h2>Advertising</h2>
      <p>
        This site displays advertising served by Google AdSense. Google and its
        partners use cookies to serve ads based on prior visits to this and other
        websites. You can opt out of personalised advertising through
        <a href="https://www.google.com/settings/ads" rel="nofollow noopener" target="_blank">Google Ads Settings</a>,
        or opt out of third-party vendor cookies at
        <a href="https://www.aboutads.info" rel="nofollow noopener" target="_blank">aboutads.info</a>.
      </p>
      <p>
        Third-party vendors, including Google, use cookies to serve ads based on a
        user's prior visits to this website. Google's use of advertising cookies
        enables it and its partners to serve ads based on visits to this site and
        other sites on the internet.
      </p>

      <h2>Cookies</h2>
      <p>
        We set no first-party tracking cookies. Cookies present on this site come
        from the advertising provider described above.
      </p>

      <h2>Your rights</h2>
      <p>
        Because we do not collect personal information, there is nothing for us to
        export, correct or delete. Requests relating to advertising data should be
        directed to the advertising provider.
      </p>

      <h2>Contact</h2>
      <p>Questions about this policy can be sent through the contact details published on this site.</p>
    </section>
  </div>
</BaseLayout>
