---
/* KIT — generic tool page structure.
   Breadcrumbs, hero, the controls/results grid, and two of the three ad
   placements. The third (mid-content) is placed by the page inside its prose,
   because only the page knows where its content breaks naturally.

   Slots: "controls", "results", and the default slot for everything below
   the fold (prose, tables, related tools). */
import AdSlot from './AdSlot.astro';

interface Props {
  title: string;
  intro: string;
  breadcrumbs: Array<{ href?: string; label: string }>;
  adSlotTop: string;
  adSlotResults: string;
  /** engine root id — must match the id passed to mount() */
  calcId: string;
}
const { title, intro, breadcrumbs, adSlotTop, adSlotResults, calcId } = Astro.props;
---
{/* The engine root wraps the whole page, not just the controls/results grid:
    tools routinely put data-out values in sections below the fold (a pro forma
    total, an IRR), and scoping the root to the grid silently leaves those
    showing an em dash forever. */}
<div class="page" data-calc={calcId} data-state="init">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    {breadcrumbs.map((c, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </>
    ))}
  </nav>

  <div class="tool-hero">
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>

  <AdSlot unit={adSlotTop} variant="leaderboard" lazy={false} />

  <div class="tool-grid">
    <div class="panel">
      <div class="panel__title">Your numbers</div>
      <slot name="controls" />
    </div>
    <div>
      <slot name="results" />
      <AdSlot unit={adSlotResults} variant="inline" />
    </div>
  </div>

  <slot />
</div>
